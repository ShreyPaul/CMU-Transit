/**
 * Result of {@link TransitFeed#tripTimetable}: one trip with its time at every stop, in travel order.
 */
type TransitFeed.TripTimetable {

  /**
   * The trip, with the same fields {@link TransitFeed#routeTrips} returns.
   */
  trip: !TransitFeed.RouteTrip

  /**
   * Every stop of the trip in travel order.
   */
  stops: [TransitFeed.TripTimetable.Stop]

  /**
   * Explanation when times are approximate or unavailable.
   */
  @db(length=2000)
  note: string

  /**
   * Time the live feed was read.
   */
  fetchedAt: !datetime
}
